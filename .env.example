# Copy to .env.local and fill in. .env.local is gitignored.
# Restart the dev server after changing anything here — Next.js reads env at boot.

# ---------------------------------------------------------------------------
# Supabase
# Project dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# Your project's REST endpoint, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key: Settings -> API Keys -> "Publishable and secret API keys".
# Looks like sb_publishable_...
#
# Safe to expose to the browser — it grants nothing on its own, because every
# table is behind row level security. Never put the secret key (sb_secret_...)
# or the legacy service_role key in a NEXT_PUBLIC_ variable: those bypass RLS
# entirely and NEXT_PUBLIC_ values are compiled into the client bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy alternative, only for projects predating the new key format. Accepted
# as a fallback if PUBLISHABLE_KEY above is unset. Supabase retires the legacy
# anon/service_role keys at the end of 2026 — prefer the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute origin used to build the links Supabase emails out (signup
# confirmation, magic link). It must match an entry in Supabase ->
# Authentication -> URL Configuration -> Redirect URLs, or the link will bounce.
#
# Local:      http://localhost:3000
# Production: https://your-domain.com
#
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL,
# then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
